PORT=3000
API_TOKEN=token de segurança para a api, será utilizada caso o 'requireToken' seja true no config.json
RCON_PASSWORD=senha do rcon dos seus servidores
URL_DISCORD_WEBHOOK=url do webhook do discord caso queira fazer a integração requer 'enableDiscord' true no config.json
RADMIN_IP=ip do radmin
FRONTEND_URL=url do frontend

GOOGLE_CLIENT_ID=seu_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback